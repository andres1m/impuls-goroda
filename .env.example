# Copy to .env and replace every value. Passwords go into connection URLs:
# use URL-safe characters only, e.g. `openssl rand -hex 24`.

POSTGRES_PASSWORD=replace-me
TEMPORAL_DB_PASSWORD=replace-me
GATEWAY_DB_PASSWORD=replace-me
OPTIMIZER_DB_PASSWORD=replace-me
SYNCER_DB_PASSWORD=replace-me
REDIS_PASSWORD=replace-me

MAX_BOT_TOKEN=replace-me

# Host ports, all bound to 127.0.0.1. Defaults shown.
# POSTGRES_PORT=5432
# EDGE_PORT=8080
# TEMPORAL_UI_PORT=8233
# PROMETHEUS_PORT=9091
# JAEGER_UI_PORT=16686

# Local run of a service outside compose.
DATABASE_URL=postgres://gateway_svc:replace-me@localhost:5432/impuls?sslmode=disable
