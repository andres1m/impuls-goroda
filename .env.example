# Copy to .env and replace every value. Passwords go into connection URLs:
# use URL-safe characters only, e.g. `openssl rand -hex 24`.

POSTGRES_PASSWORD=replace-me
TEMPORAL_DB_PASSWORD=replace-me
GATEWAY_DB_PASSWORD=replace-me
OPTIMIZER_DB_PASSWORD=replace-me
SYNCER_DB_PASSWORD=replace-me
REDIS_PASSWORD=replace-me

MAX_BOT_TOKEN=replace-me
MAX_WEBHOOK_SECRET=replace-me
LIFECYCLE_SHARED_SECRET=replace-me
MAX_BOT_USERNAME=your_bot_username

# Enable only after the delivery-state migrations and MAX subscription are ready.
GATEWAY_MAX_DELIVERY_EVENTS_ENABLED=false
GATEWAY_NOTIFICATION_DELIVERY_ENABLED=false
GATEWAY_SCENARIO_RESULT_DELIVERY_ENABLED=false

# Polza is the default provider for embedding and text models; may stay empty.
POLZA_API_KEY=
# OpenRouter key when selected in the service config; may stay empty.
OPENROUTER_API_KEY=

# Service ports are bound to 127.0.0.1; the optional public web profile binds 80/443.
# POSTGRES_PORT=5432
# EDGE_PORT=8080
# WEB_DIST_DIR=./web/dist
# TWO_GIS_API_KEY=your_2gis_subscription_key
# TEMPORAL_UI_PORT=8233
# PROMETHEUS_PORT=9091
# JAEGER_UI_PORT=16686
# OPTIMIZER_AI_ADMIN_PORT=8095

# Required only with compose.product.yaml; use a distinct tag per source commit.
# RELEASE_TAG=your-release-tag
# SOURCE_REVISION=full-source-commit
# WEB_RUNTIME_CONFIG=./docker/caddy/config.json
# WEB_DIST_DIR=./web/dist

# Local run of a service outside compose.
DATABASE_URL=postgres://gateway_svc:replace-me@localhost:5432/impuls?sslmode=disable
